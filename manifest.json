{
  "manifest_version": 3,
  "name": "280 Twitter Cutoff Highlighter",
  "version": "1.0.0",
  "author": "Alexey Inkin",
  "description": "Highlights where the 280-character untrimmed post limit ends while composing on X (Twitter) Premium, plus a live character counter.",
  "permissions": [
    "storage"
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "280 Twitter Cutoff Highlighter"
  },
  "content_scripts": [
    {
      "matches": [
        "*://twitter.com/*",
        "*://*.twitter.com/*",
        "*://x.com/*",
        "*://*.x.com/*"
      ],
      "js": [
        "content.js"
      ],
      "css": [
        "styles.css"
      ],
      "run_at": "document_idle"
    }
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "twitter-cutoff-highlighter@ainkin.com",
      "strict_min_version": "120.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  }
}
